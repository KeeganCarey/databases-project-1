<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Top Mentors Leaderboard - MentorBridge</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 1000px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #2c3e50; }
    a { color: #2980b9; text-decoration: none; }
    a:hover { text-decoration: underline; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background: #2c3e50; color: white; }
    tr:nth-child(even) { background: #f9f9f9; }
    .actions { white-space: nowrap; }
    .actions a, .actions button { margin-right: 5px; }
    button { background: #e74c3c; color: white; border: none; padding: 4px 10px; cursor: pointer; border-radius: 3px; }
    button:hover { background: #c0392b; }
    .btn-add { display: inline-block; margin-bottom: 10px; background: #27ae60; color: white; padding: 8px 16px; border-radius: 4px; }
    .btn-add:hover { background: #219a52; color: white; text-decoration: none; }
    .rank { width: 50px; text-align: center; font-weight: bold; }
  </style>
</head>
<body>
  <h1>Top Mentors Leaderboard</h1>
  <a href="/leaderboard/new" class="btn-add">+ Add Mentor</a>
  <table>
    <thead>
      <tr>
        <th class="rank">Rank</th>
        <th>Name</th>
        <th>Score</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (entries.length === 0) { %>
        <tr><td colspan="4" style="text-align:center; padding:20px;">No mentors on the leaderboard yet.</td></tr>
      <% } %>
      <% entries.forEach((e, i) => { %>
        <tr>
          <td class="rank">#<%= i + 1 %></td>
          <td><%= e.name %></td>
          <td><%= e.score %></td>
          <td class="actions">
            <a href="/leaderboard/<%= encodeURIComponent(e.name) %>/edit">Edit</a>
            <form method="POST" action="/leaderboard/<%= encodeURIComponent(e.name) %>/delete" style="display:inline"
                  onsubmit="return confirm('Remove this mentor from the leaderboard?')">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
