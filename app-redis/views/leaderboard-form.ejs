<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= entry ? 'Edit' : 'Add' %> Mentor - Leaderboard</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #2c3e50; }
    a { color: #2980b9; text-decoration: none; }
    a:hover { text-decoration: underline; }
    label { display: block; margin-top: 15px; font-weight: bold; }
    input { width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 3px; box-sizing: border-box; }
    button { margin-top: 20px; background: #27ae60; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 4px; font-size: 16px; }
    button:hover { background: #219a52; }
    nav { margin-bottom: 20px; }
  </style>
</head>
<body>
  <nav><a href="/leaderboard">&larr; Back to Leaderboard</a></nav>
  <h1><%= entry ? 'Edit Mentor' : 'Add Mentor to Leaderboard' %></h1>

  <form method="POST" action="<%= entry ? `/leaderboard/${encodeURIComponent(entry.name)}/update` : '/leaderboard' %>">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" required value="<%= entry ? entry.name : '' %>">

    <label for="score">Score</label>
    <input type="number" id="score" name="score" step="1" required value="<%= entry ? entry.score : '' %>">

    <button type="submit"><%= entry ? 'Save Changes' : 'Add to Leaderboard' %></button>
  </form>
</body>
</html>
